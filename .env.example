# Frontend settings, used from Stage B on. Copy to .env.local (gitignored).
#
# Vite embeds every VITE_ variable in the public browser bundle, so only public values belong here.
# Never put a secret key, service-role key, database URL, or password in a VITE_ variable.

# Project API URL: https://<project-ref>.supabase.co, or http://127.0.0.1:54321 for the local stack.
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...). For the local stack, run `supabase status`.
VITE_SUPABASE_PUBLISHABLE_KEY=
