# Edge Function settings. For local development, copy to supabase/functions/.env (gitignored).
# For a hosted project, use `supabase secrets set NAME=value` instead.
# SUPABASE_URL and the API keys are injected by Supabase; never add them here.

# Comma-separated exact browser origins (scheme://host[:port]) allowed to call the functions.
# Unset or empty rejects every browser origin. Wildcards and "null" are never accepted.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Per-network rate limiting stays off unless this names a client-IP header that the staging trust
# check (supabase/README.md) proved cannot be forged. X-Forwarded-For and Forwarded are refused.
# Every other header, including X-Real-IP, is forgeable unless that check shows the platform
# overwrites it, so never set this without running the check.
# CLIENT_IP_HEADER=
