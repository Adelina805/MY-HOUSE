{
  "name": "my-house",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog:check && tsc && vite build",
    "preview": "vite preview",
    "catalog:generate": "node --experimental-strip-types scripts/generate-prize-catalog.ts",
    "catalog:check": "node --experimental-strip-types scripts/generate-prize-catalog.ts --check",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:functions": "npm run catalog:check && deno test --config supabase/functions/tests/deno.json --allow-env --allow-read supabase/functions/tests/unit",
    "test:integration": "deno test --config supabase/functions/tests/deno.json --allow-env --allow-read --allow-run=supabase --allow-net=127.0.0.1:54321,127.0.0.1:54322,localhost:54321,localhost:54322 supabase/functions/tests/integration",
    "test:frontend": "deno test --config tests/frontend/deno.json tests/frontend/unit",
    "test:frontend:integration": "deno test --config tests/frontend/deno.json --allow-env --allow-read --allow-run=supabase --allow-net=127.0.0.1:54321,127.0.0.1:54322,localhost:54321,localhost:54322 tests/frontend/integration"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0"
  }
}
